static func get_weapon_data(weapon_id: String) -> Dictionary:
	return weapon_data.get(weapon_id, {})

static func get_all_weapons() -> Dictionary:
	return weapon_data

static func get_weapons_by_category(category: String) -> Array[Dictionary]:
	var result = []
	for id, data in weapon_data:
		if data.get("category") == category:
			result.append(data)
	return result

static func get_weapon_categories() -> Array[String]:
	var categories = []
	for id, data in weapon_data:
		var cat = data.get("category", "")
		if cat != "" and cat not in categories:
			categories.append(cat)
	return categories

static func is_melee(weapon_id: String) -> bool:
	var data = weapon_data.get(weapon_id, {})
	return data.get("type") == "MELEE"

static func is_ranged(weapon_id: String) -> bool:
	var data = weapon_data.get(weapon_id, {})
	return data.get("type") != "MELEE"