[application]

config/name="City Life"
config/icon="res://assets/textures/icon.png"
config/main_scene="res://scenes/main_menu/main_menu.tscn"
run/low_processor_mode_sleep_usec=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/size/fullscreen_mode=2
window/vsync_mode=1
rendering/renderer/rendering_method="mobile"
rendering/quality/shadows/quality=1
rendering/quality/reflections/ssrr=true
rendering/quality/reflections/ssrr_roughness_quality=1
rendering/quality/ssao/enabled=true
rendering/quality/ssao/quality=1
rendering/quality/canvas_textures/default_texture_filter=1
rendering/quality/canvas_textures/default_texture_repeat=0
rendering/limits/rendering/max_elements_per_frame=200000
rendering/limits/time/max_render_time=1000
rendering/environment/defaults/default_clear_color=Color(0.1, 0.15, 0.2, 1)
rendering/environment/defaults/default_environment="res://assets/environments/default_env.tres"

[input]

move_left={
"deadzone": 0.5,
"events": [
	{
		"type": "InputEventKey",
		"physical_keycode": 65,
		"keycode": 65,
		"pressed": true
	},
	{
		"type": "InputEventJoypadMotion",
		"axis": 0,
		"axis_value": -1.0
	}
]
}
move_right={
"deadzone": 0.5,
"events": [
	{
		"type": "InputEventKey",
		"physical_keycode": 68,
		"keycode": 68,
		"pressed": true
	},
	{
		"type": "InputEventJoypadMotion",
		"axis": 0,
		"axis_value": 1.0
	}
]
}
move_forward={
