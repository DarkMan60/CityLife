[autoload]

GameManager="*res://autoload/game_manager.gd"
InputManager="*res://autoload/input_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
UIManager="*res://autoload/ui_manager.gd"
WorldManager="*res://autoload/world_manager.gd"
MissionManager="*res://autoload/mission_manager.gd"
PoliceManager="*res://autoload/police_manager.gd"
VehicleManager="*res://autoload/vehicle_manager.gd"
PedestrianManager="*res://autoload/pedestrian_manager.gd"
TrafficManager="*res://autoload/traffic_manager.gd"
GraphicsSettings="*res://autoload/graphics_settings.gd"
WeaponManager="*res://autoload/weapon_manager.gd"
CameraManager="*res://autoload/camera_manager.gd"
LODManager="*res://autoload/lod_manager.gd"

[physics]

common/physics_ticks_per_second=60
3d/physics/3d/solver_iterations=8
3d/physics/3d/default_solver_accuracy=1.0
3d/physics/3d/default_contact_margin=0.04

[rendering]

rendering/quality/depth_prepass/enabled=true
rendering/quality/depth_prepass/readback_mode=0
rendering/quality/filters/bicubic_upscale=true
rendering/quality/filters/fsr_mode=0
rendering/quality/shadows/atlas_size=2048
rendering/quality/shadows/max_directional_lights=2
rendering/quality/shadows/max_dual_parabola_lights=2
rendering/quality/shadows/max_spot_lights=4
rendering/quality/shadows/max_omni_lights=2
rendering/quality/ssao/half_resolution=false
rendering/quality/ssao/bilateral_sharpness=1.5
rendering/quality/ssil/enabled=true
rendering/quality/ssr/enabled=true
rendering/quality/ssr/roughness_quality=1
rendering/quality/decal/atlas_size=1024
rendering/quality/lightmap/max_lightmaps=8
rendering/quality/gi/voxel_gi/enabled=false
rendering/quality/gi/voxel_gi/subdivs=6
rendering/quality/gi/sdfgi/enabled=false
rendering/quality/gi/sdfgi/cascades=8
rendering/quality/reflection_probes/max_reflection_probes=16
rendering/quality/reflection_probes/atlas_size=2048
rendering/quality/particles/collision_max_particles=1000
rendering/quality/particles/max_emission_per_frame=1000
rendering/quality/particles/subpixel_accuracy=true
rendering/quality/lod/mesh_lod_threshold=0.1
rendering/quality/lod/particle_lod_threshold=0.1
rendering/quality/lod/cross_fade_margin=1.0
rendering/quality/occlusion_culling/enabled=true
rendering/quality/occlusion_culling/use_occluders=true
rendering/quality/occlusion_culling/use_portals=true
rendering/quality/reflections/ssrr_roughness_quality=1
rendering/quality/reflections/ssrr_samples=16

[global_classes]

CharacterBody3D="res://scripts/core/character_body_3d.gd"
VehicleBody3D="res://scripts/core/vehicle_body_3d.gd"
StaticBody3D="res://scripts/core/static_body_3d.gd"
RigidBody3D="res://scripts/core/rigid_body_3d.gd"